from typing import overload

class Z3Exception(Exception): ...

class Context:
    def __init__(self) -> None: ...

class CheckSatResult:
    def __eq__(self, other: object) -> bool: ...
    def __ne__(self, other: object) -> bool: ...

sat: CheckSatResult
unsat: CheckSatResult
unknown: CheckSatResult

class ExprRef:
    ctx: Context
    def sexpr(self) -> str: ...
    def __str__(self) -> str: ...

class BoolRef(ExprRef): ...

class ArithRef(ExprRef):
    def is_int(self) -> bool: ...
    def is_real(self) -> bool: ...
    def __neg__(self) -> ArithRef: ...
    def __add__(self, other: ArithRef | int | float) -> ArithRef: ...
    def __sub__(self, other: ArithRef | int | float) -> ArithRef: ...
    def __mul__(self, other: ArithRef | int | float) -> ArithRef: ...
    def __truediv__(self, other: ArithRef | int | float) -> ArithRef: ...
    def __mod__(self, other: ArithRef | int) -> ArithRef: ...
    def __lt__(self, other: ArithRef | int | float) -> BoolRef: ...
    def __le__(self, other: ArithRef | int | float) -> BoolRef: ...
    def __gt__(self, other: ArithRef | int | float) -> BoolRef: ...
    def __ge__(self, other: ArithRef | int | float) -> BoolRef: ...

class IntNumRef(ArithRef):
    def as_long(self) -> int: ...

class RatNumRef(ArithRef):
    def as_decimal(self, prec: int = ...) -> str: ...

class SeqRef(ExprRef):
    def as_string(self) -> str: ...
    def is_string_value(self) -> bool: ...

class ModelRef:
    def eval(self, t: ExprRef, model_completion: bool = ...) -> ExprRef: ...
    def sexpr(self) -> str: ...

class Solver:
    ctx: Context
    def __init__(self, solver: object = ..., ctx: Context | None = ...) -> None: ...
    def set(self, *args: str | int | float | bool, **keys: str | int | float | bool) -> None: ...
    def add(self, *args: BoolRef) -> None: ...
    def push(self) -> None: ...
    def pop(self, num: int = ...) -> None: ...
    def check(self, *assumptions: BoolRef) -> CheckSatResult: ...
    def model(self) -> ModelRef: ...
    def reason_unknown(self) -> str: ...

def Int(name: str, ctx: Context | None = ...) -> ArithRef: ...
def IntVal(val: int, ctx: Context | None = ...) -> IntNumRef: ...
def Real(name: str, ctx: Context | None = ...) -> ArithRef: ...
def RealVal(val: float | int | str, ctx: Context | None = ...) -> RatNumRef: ...
def Bool(name: str, ctx: Context | None = ...) -> BoolRef: ...
def BoolVal(val: bool, ctx: Context | None = ...) -> BoolRef: ...
def String(name: str, ctx: Context | None = ...) -> SeqRef: ...
def StringVal(s: str, ctx: Context | None = ...) -> SeqRef: ...
def ToReal(a: ArithRef) -> ArithRef: ...
def Abs(arg: ArithRef) -> ArithRef: ...
def Not(a: BoolRef, ctx: Context | None = ...) -> BoolRef: ...
def Implies(a: BoolRef, b: BoolRef, ctx: Context | None = ...) -> BoolRef: ...
def And(*args: BoolRef | Context) -> BoolRef: ...
def Or(*args: BoolRef | Context) -> BoolRef: ...
def Distinct(*args: ExprRef) -> BoolRef: ...
def Length(s: SeqRef) -> ArithRef: ...
def PrefixOf(a: SeqRef, b: SeqRef) -> BoolRef: ...
def Concat(*args: SeqRef) -> SeqRef: ...
@overload
def If(a: BoolRef, b: BoolRef, c: BoolRef, ctx: Context | None = ...) -> BoolRef: ...
@overload
def If(a: BoolRef, b: ArithRef, c: ArithRef, ctx: Context | None = ...) -> ArithRef: ...
@overload
def If(a: BoolRef, b: SeqRef, c: SeqRef, ctx: Context | None = ...) -> SeqRef: ...
@overload
def If(a: BoolRef, b: ExprRef, c: ExprRef, ctx: Context | None = ...) -> ExprRef: ...
