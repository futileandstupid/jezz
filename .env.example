# Temporary local development environment template (gitignored `.env`).
# NOTE: Plaintext `.env` files are strictly transitional for early local trials.
# Long-term secret injection should run via Proton Pass CLI (`pass-cli run`) so API
# credentials never sit unencrypted on disk (aligning with JBC-SEC-002):
#   pass-cli run --env-file .env.pass -- uv run jezz run <repo> --model google:gemini-3.8-flash ...

# Google Gemini Developer API (used by `pydantic-ai` `google:<model>` provider):
GEMINI_API_KEY=
